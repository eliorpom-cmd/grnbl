<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template. Install (from the repo folder):
     sed -e "s|__GRNBL_DIR__|$PWD|g" -e "s|__HOME__|$HOME|g" deploy/dev.byelior.grnbl.plist > ~/Library/LaunchAgents/dev.byelior.grnbl.plist
     launchctl load ~/Library/LaunchAgents/dev.byelior.grnbl.plist -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.byelior.grnbl</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__GRNBL_DIR__/deploy/tick.sh</string>
    </array>

    <!-- Every hour on the hour; grnbl/tick.py does what is due and each thing once.
         If the Mac was asleep, launchd fires on wake. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>__HOME__</string>
    </dict>

    <key>StandardOutPath</key>
    <string>__GRNBL_DIR__/data/logs/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>__GRNBL_DIR__/data/logs/launchd.log</string>
</dict>
</plist>
