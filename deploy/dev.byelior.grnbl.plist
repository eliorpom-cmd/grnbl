<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.byelior.grnbl</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__GRNBL_DIR__/deploy/morning.sh</string>
    </array>

    <!-- 10:00, an hour after the Mac is usually open; if it was asleep, launchd fires
         on wake. A second try at 14:00 covers a failed morning; the script's
         once-a-day marker prevents a second run after a good one. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>10</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>14</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>__HOME__</string>
    </dict>

    <key>StandardOutPath</key>
    <string>__GRNBL_DIR__/data/logs/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>__GRNBL_DIR__/data/logs/launchd.log</string>
</dict>
</plist>
